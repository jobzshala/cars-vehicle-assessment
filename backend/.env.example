# Copy to .env for local development. Every variable is validated at startup (src/config/schema.ts).

# --- Runtime ---
# development | test | production  (development enables pretty logs and the GraphQL playground)
NODE_ENV=development
# HTTP port the server listens on
PORT=3000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Database (required) ---
# PostgreSQL connection string. Matches the db service in docker-compose.yml.
DATABASE_URL=postgresql://vehicles:vehicles@localhost:5432/vehicles
# Host port docker-compose publishes Postgres on (only used by docker-compose; change if 5432 is taken)
DB_PORT=5432

# --- External API ---
# Base URL of the NHTSA vPIC API (override to point at a mock in tests)
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles
# Per-request timeout in milliseconds
HTTP_TIMEOUT_MS=10000
# Retries per request for network errors, timeouts, 429 and 5xx responses (0-10)
HTTP_RETRIES=3
# First retry delay; doubles each attempt with 20% jitter
HTTP_RETRY_BASE_DELAY_MS=300

# --- Ingestion ---
# How many vehicle-type requests run in parallel (1-50)
INGEST_CONCURRENCY=10
# Makes persisted per database transaction
INGEST_BATCH_SIZE=500
# Optional cap on the number of makes ingested (handy in development: NHTSA has ~12,000 makes)
INGEST_MAKE_LIMIT=
# Feature flag: run ingestion automatically when the datastore is empty at startup
INGEST_ON_STARTUP=true
